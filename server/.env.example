# Copy to server/.env

NODE_ENV=development
PORT=4000

# Neon pooled connection string. Leave blank only for local in-memory development.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/comfyhub?sslmode=require

# Production refuses to start with a blank DATABASE_URL unless this is explicitly true.
ALLOW_IN_MEMORY_DB=false

# Default: enabled in development, disabled in production. Never enable on a fresh public database.
SEED_DEMO_DATA=false

# Generate each with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use two DIFFERENT values. Keep both private and server-side only.
JWT_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-different-long-random-secret

# Comma-separated origins allowed to call the API directly. Required in production.
CLIENT_ORIGIN=http://localhost:5173

# Set to true only when the API is behind Cloudflare or a reverse proxy.
TRUST_PROXY=false
